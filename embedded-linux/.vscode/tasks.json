{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run on QEMU",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/dev.sh",
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "QEMU: Open shell",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/dev.sh",
        "shell"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "QEMU: Power off",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/dev.sh",
        "stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
